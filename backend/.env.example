# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_secure_password
DB_NAME=it_management

# JWT
JWT_SECRET=your_very_secure_secret_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Server
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# MFA
MFA_ISSUER=ITCredentialManagement
MFA_APP_NAME=IT-Management

# Crypto
CRYPTO_ALGORITHM=aes-256-gcm
KMS_STUB_KEY=your_kms_key_reference_or_stub_key

# CORS
CORS_ORIGIN=http://localhost:4200

# Log Level
LOG_LEVEL=info

# Security
PASSWORD_HASH_ROUNDS=12
PIN_HASH_ROUNDS=12
REVEAL_TTL_SECONDS=30
