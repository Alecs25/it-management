{
  "name": "it-credential-management-backend",
  "version": "0.1.0",
  "description": "IT Credential Management App - Backend (ISO 27001 Compliant)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "ts-node src/database/migration.ts",
    "seed": "ts-node src/database/seed.ts",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "credentials",
    "security",
    "iso27001",
    "2fa"
  ],
  "author": "IT Management Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "express": "^4.18.2",
    "typeorm": "^0.3.17",
    "mysql2": "^3.6.5",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "jsonwebtoken": "^9.1.2",
    "argon2": "^0.31.2",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "helmet": "^7.1.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "crypto": "node:crypto"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/jest": "^29.5.11",
    "@types/speakeasy": "^2.0.10",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
